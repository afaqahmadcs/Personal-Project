# Deployment Environment Variable Configurations
# OVERWRITE: Replace with your actual credentials in .env.local

# Real-world domain URL for generating absolute canonicals and XML sitemaps
NEXT_PUBLIC_SITE_URL=https://github.com/afaqahmadcs/Personal-Project

# Email provider integration parameters for Contact Start a Project route
# Example: resend_api_key_goes_here
RESEND_API_KEY=

# Primary destination address where project inquiries should be delivered
# Example: your-inbox@domain.com
CONTACT_EMAIL=

# Analytics tracking configurations
NEXT_PUBLIC_ANALYTICS_ID=
